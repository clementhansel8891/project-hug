{
  "name": "zenvix-backend",
  "version": "1.0.4",
  "description": "Zenvix Platform Backend - Multi-Tenant Business OS",
  "author": "Zenvix Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-old-space-size=2048 dist/main.js",
    "start:worker": "node --max-old-space-size=1024 dist/worker.js",
    "start:all": "concurrently \"npm run start:prod\" \"npm run start:worker\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:validate-schema": "node -e \"const fs=require('fs');const p='database/schema.sql';if(!fs.existsSync(p)){console.error('Missing '+p);process.exit(1);}console.log('Schema file ready:',p);\"",
    "prisma:generate": "prisma generate",
    "validate:flow": "ts-node scripts/run-validation.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "6.2.1",
    "@types/dotenv": "^6.1.1",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.2.1",
    "csv-parser": "^3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "eventemitter2": "^6.4.9",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.0.2",
    "twilio": "^6.0.1",
    "uuid": "^14.0.0",
    "zod": "4.3.6"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "adm-zip": "^0.5.17",
    "eslint": "^8.56.0",
    "fast-check": "^4.8.0",
    "prettier": "^3.2.4",
    "prisma": "6.2.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  }
}
